{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "comic-theme.css",
      "use": "@vercel/static"
    },
    {
      "src": "logo.png",
      "use": "@vercel/static"
    },
    {
      "src": "speakup-logo.svg",
      "use": "@vercel/static"
    },
    {
      "src": "speakup-logo-on-light.svg",
      "use": "@vercel/static"
    },
    {
      "src": "mode-shift.js",
      "use": "@vercel/static"
    },
    {
      "src": "ksjsbwuil-digital-click-3-513897.mp3",
      "use": "@vercel/static"
    },
    {
      "src": "firebase-auth.bundle.js",
      "use": "@vercel/static"
    },
    {
      "src": "assets/mode-shift/casual.webp",
      "use": "@vercel/static"
    },
    {
      "src": "assets/mode-shift/interview.webp",
      "use": "@vercel/static"
    },
    {
      "src": "coach/ui.js",
      "use": "@vercel/static"
    },
    {
      "src": "coach/coach.bundle.js",
      "use": "@vercel/static"
    },
    {
      "src": "coach/catalog.js",
      "use": "@vercel/static"
    },
    {
      "src": "coach/render.js",
      "use": "@vercel/static"
    },
    {
      "src": "coach/state.js",
      "use": "@vercel/static"
    },
    {
      "src": "coach/export.js",
      "use": "@vercel/static"
    },
    {
      "src": "coach/coach.css",
      "use": "@vercel/static"
    },
    {
      "src": "assets/fonts/Inter-Variable-latin.woff2",
      "use": "@vercel/static"
    },
    {
      "src": "assets/fonts/BebasNeue-Regular-latin.woff2",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api/transcribe$",
      "dest": "server.js"
    },
    {
      "src": "^/api/analyze$",
      "dest": "server.js"
    },
    {
      "src": "^/api/interview/start$",
      "dest": "server.js"
    },
    {
      "src": "^/api/interview/continue$",
      "dest": "server.js"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ]
}
